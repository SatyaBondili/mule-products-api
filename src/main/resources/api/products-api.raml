#%RAML 1.0
title: Products API
version: v1
baseUri: https://api.example.com/products-api/{version}
protocols: [HTTPS]
mediaType: application/json
description: |
  CRUD API for managing product information. The data model mirrors the
  columns of products.csv (the backing data source).

securitySchemes:
  clientIdEnforcement:
    description: Client ID / secret pair issued by API Manager
    type: x-custom
    describedBy:
      headers:
        client_id:
          description: Client ID of the consuming application
          type: string
        client_secret:
          description: Client secret of the consuming application
          type: string
      responses:
        401:
          description: Missing or invalid client credentials

securedBy: [clientIdEnforcement]

types:
  Product:
    description: A product as stored in products.csv
    type: object
    properties:
      productId:
        type: integer
        description: Unique product identifier (generated by the API on create)
        example: 1001
      sku:
        type: string
        description: Stock keeping unit, unique per product
        pattern: ^[A-Z0-9-]{3,30}$
        example: LAP-DEL-001
      name:
        type: string
        minLength: 1
        maxLength: 150
        example: Dell Inspiron 15
      description:
        type: string
        required: false
        maxLength: 500
        example: 15.6 inch laptop with 16GB RAM and 512GB SSD
      category:
        type: string
        example: Electronics
      brand:
        type: string
        required: false
        example: Dell
      price:
        type: number
        minimum: 0
        example: 58999.00
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        default: INR
        example: INR
      stockQuantity:
        type: integer
        minimum: 0
        example: 25
      active:
        type: boolean
        default: true
        example: true
      createdDate:
        type: date-only
        description: Set by the API on create (YYYY-MM-DD)
        example: 2026-01-10

  ProductInput:
    description: Payload for creating or fully replacing a product (no productId or createdDate)
    type: object
    properties:
      sku:
        type: string
        pattern: ^[A-Z0-9-]{3,30}$
        example: LAP-DEL-001
      name:
        type: string
        minLength: 1
        maxLength: 150
        example: Dell Inspiron 15
      description:
        type: string
        required: false
        maxLength: 500
      category:
        type: string
        example: Electronics
      brand:
        type: string
        required: false
      price:
        type: number
        minimum: 0
        example: 58999.00
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        default: INR
      stockQuantity:
        type: integer
        minimum: 0
        example: 25
      active:
        type: boolean
        default: true

  ProductPatch:
    description: Partial update; send only the fields you want to change
    type: object
    properties:
      name?:
        type: string
        minLength: 1
        maxLength: 150
      description?:
        type: string
        maxLength: 500
      category?:
        type: string
      brand?:
        type: string
      price?:
        type: number
        minimum: 0
      currency?:
        type: string
        pattern: ^[A-Z]{3}$
      stockQuantity?:
        type: integer
        minimum: 0
      active?:
        type: boolean

  ProductList:
    type: object
    properties:
      total:
        type: integer
        description: Total number of products matching the filters
        example: 15
      offset:
        type: integer
        example: 0
      limit:
        type: integer
        example: 10
      items:
        type: Product[]

  Error:
    type: object
    properties:
      code:
        type: integer
        example: 404
      message:
        type: string
        example: Product not found
      details:
        type: string[]
        required: false

traits:
  hasNotFound:
    responses:
      404:
        description: Product not found
        body:
          application/json:
            type: Error
            example:
              code: 404
              message: Product not found
  hasBadRequest:
    responses:
      400:
        description: Invalid request payload or parameters
        body:
          application/json:
            type: Error
            example:
              code: 400
              message: Validation failed
              details: ["price must be >= 0"]
  hasServerError:
    responses:
      500:
        description: Unexpected server error
        body:
          application/json:
            type: Error
            example:
              code: 500
              message: Internal server error
  pageable:
    queryParameters:
      offset:
        type: integer
        minimum: 0
        default: 0
        required: false
        description: Number of records to skip
      limit:
        type: integer
        minimum: 1
        maximum: 100
        default: 10
        required: false
        description: Maximum number of records to return

/products:
  displayName: Products
  get:
    description: List products, with optional filters and pagination
    is: [pageable, hasBadRequest, hasServerError]
    queryParameters:
      category:
        type: string
        required: false
        description: Filter by category (exact match)
        example: Electronics
      brand:
        type: string
        required: false
        description: Filter by brand (exact match)
      active:
        type: boolean
        required: false
        description: Filter by active status
      search:
        type: string
        required: false
        description: Case-insensitive match on name or description
    responses:
      200:
        body:
          application/json:
            type: ProductList
            example:
              total: 2
              offset: 0
              limit: 10
              items:
                - productId: 1001
                  sku: LAP-DEL-001
                  name: Dell Inspiron 15
                  description: 15.6 inch laptop with 16GB RAM and 512GB SSD
                  category: Electronics
                  brand: Dell
                  price: 58999.00
                  currency: INR
                  stockQuantity: 25
                  active: true
                  createdDate: 2026-01-10
                - productId: 1002
                  sku: LAP-HP-002
                  name: HP Pavilion 14
                  description: 14 inch thin and light laptop with Intel i5
                  category: Electronics
                  brand: HP
                  price: 62499.00
                  currency: INR
                  stockQuantity: 18
                  active: true
                  createdDate: 2026-01-12
  post:
    description: Create a new product. productId and createdDate are generated by the API.
    is: [hasBadRequest, hasServerError]
    body:
      application/json:
        type: ProductInput
        example:
          sku: TAB-APL-016
          name: Apple iPad 10th Gen
          description: 10.9 inch tablet with 64GB storage
          category: Electronics
          brand: Apple
          price: 34900.00
          currency: INR
          stockQuantity: 30
          active: true
    responses:
      201:
        description: Product created
        headers:
          Location:
            description: URL of the newly created product
            type: string
            example: /products/1016
        body:
          application/json:
            type: Product
            example:
              productId: 1016
              sku: TAB-APL-016
              name: Apple iPad 10th Gen
              description: 10.9 inch tablet with 64GB storage
              category: Electronics
              brand: Apple
              price: 34900.00
              currency: INR
              stockQuantity: 30
              active: true
              createdDate: 2026-10-07
      409:
        description: A product with this SKU already exists
        body:
          application/json:
            type: Error
            example:
              code: 409
              message: SKU already exists

  /{productId}:
    displayName: Product
    uriParameters:
      productId:
        type: integer
        description: Unique product identifier
        example: 1001
    get:
      description: Get a single product by ID
      is: [hasNotFound, hasServerError]
      responses:
        200:
          body:
            application/json:
              type: Product
              example:
                productId: 1001
                sku: LAP-DEL-001
                name: Dell Inspiron 15
                description: 15.6 inch laptop with 16GB RAM and 512GB SSD
                category: Electronics
                brand: Dell
                price: 58999.00
                currency: INR
                stockQuantity: 25
                active: true
                createdDate: 2026-01-10
    put:
      description: Fully replace an existing product. All ProductInput fields are required except the optional ones.
      is: [hasNotFound, hasBadRequest, hasServerError]
      body:
        application/json:
          type: ProductInput
          example:
            sku: LAP-DEL-001
            name: Dell Inspiron 15
            description: 15.6 inch laptop with 16GB RAM and 1TB SSD
            category: Electronics
            brand: Dell
            price: 61999.00
            currency: INR
            stockQuantity: 20
            active: true
      responses:
        200:
          description: Product replaced
          body:
            application/json:
              type: Product
        409:
          description: SKU already used by another product
          body:
            application/json:
              type: Error
              example:
                code: 409
                message: SKU already exists
    patch:
      description: Partially update a product (price, stock, active flag, etc.)
      is: [hasNotFound, hasBadRequest, hasServerError]
      body:
        application/json:
          type: ProductPatch
          example:
            price: 55999.00
            stockQuantity: 30
      responses:
        200:
          description: Product updated
          body:
            application/json:
              type: Product
    delete:
      description: Delete a product by ID
      is: [hasNotFound, hasServerError]
      responses:
        204:
          description: Product deleted; no content returned
